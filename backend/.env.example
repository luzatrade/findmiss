# Esempio di variabili d'ambiente per il backend
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/findmiss?schema=public
JWT_SECRET=change_this_to_a_long_random_string
UPLOADS_PATH=./uploads
# Persistenza media in produzione (consigliato su Railway — il disco del container è effimero)
# S3_BUCKET=findmiss-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret
NODE_ENV=development